# Copy to .env and fill in. .env is git-ignored: real keys never get committed.
#   cp .env.example .env

# Langfuse project keys: Langfuse UI -> Settings -> API Keys -> Create new API keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Where Langfuse runs. Self-hosted on your Mac: http://localhost:3000
# Langfuse Cloud: https://us.cloud.langfuse.com (US) or https://cloud.langfuse.com (EU)
# SDK v5 reads LANGFUSE_BASE_URL. LANGFUSE_HOST is the older name and still works, but is deprecated.
LANGFUSE_BASE_URL=http://localhost:3000

# Claude, for the copilot (Haiku) and the judge (Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# LANGFUSE_TRACING_ENABLED=false   # switch tracing off without touching code
# LANGFUSE_SAMPLE_RATE=0.1         # keep 10% of traces (production cost control)
# LANGFUSE_TRACING_ENVIRONMENT=local
